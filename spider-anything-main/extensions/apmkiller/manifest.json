{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.0.1",
  "description": "__MSG_appDesc__",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_icon": {
      "32": "icon32.png",
      "48": "icon48.png",
      "64": "icon64.png"
    }
  },
  "icons": {
    "32": "icon32.png",
    "48": "icon48.png",
    "64": "icon64.png"
  },
  "default_locale": "zh_CN",
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "index.js"
      ],
      "css": [],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon16.png",
        "icon32.png",
        "icon48.png",
        "icon64.png"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}